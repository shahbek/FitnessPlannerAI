{
  "name": "fitness-planner-ai",
  "version": "1.0.0",
  "description": "AI-powered personal fitness trainer with Groq integration",
  "type": "module",
  "scripts": {
    "validate-env": "tsx src/utils/validateEnv.ts",
    "dev": "vite",
    "build": "npx convex codegen && tsc && vite build",
    "preview": "vite preview",
    "convex:dev": "npx convex dev",
    "convex:deploy": "npx convex deploy",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "npm run test:smoke",
    "test:smoke": "node --import tsx src/tests/unit/PlanTargetsOverrideExtractor.test.ts && node --import tsx src/tests/unit/NutritionCaloriesOverride.test.ts && node --import tsx src/tests/unit/GetTDEEUserProfileShape.test.ts && node --import tsx src/tests/unit/SupplementMealsBypassLP.test.ts && node --import tsx src/tests/unit/PhaseCachedWorkouts.test.ts",
    "test:watch": "node --import tsx --watch src/tests/unit/PlanTargetsOverrideExtractor.test.ts",
    "test:api": "node --import tsx src/tests/apiKeyValidator.test.ts",
    "test:profile": "node --import tsx src/tests/candidateProfile.test.ts",
    "test:planning": "node --import tsx src/tests/integratedPlanningService.test.ts",
    "test:reasoning": "node --import tsx test-two-step-reasoning.ts",
    "test:usda": "node --import tsx src/tests/unit/USDANutritionService.test.ts",
    "debug:meals": "node --import tsx src/tests/manual/WeeklyMealGenerationDebug.ts",
    "debug:custom-meals": "node --import tsx src/tests/manual/CustomMealAdjustmentDemo.ts",
    "test:dummy": "node --import tsx src/tests/unit/DummyWeeklyAdjust.test.ts",
    "test:workout-pipeline": "node --import tsx src/tests/integration/WorkoutGenerationPipeline.test.ts",
    "test:weekly-workout-generation": "node --import tsx src/tests/integration/WeeklyWorkoutGeneration.test.ts",
    "test:integration": "node --import tsx src/tests/integration/IntegratedPlanGenerator.test.ts",
    "test:full-generation": "node --import tsx src/tests/integration/FullPlanGeneration.test.ts",
    "test:all": "npm run test:usda && npm run test:workout-pipeline && npm run test:integration && npm run test:full-generation"
  },
  "dependencies": {
    "@ai-sdk/groq": "^2.0.24",
    "@ai-sdk/openai": "^2.0.52",
    "@auth/core": "^0.37.4",
    "@convex-dev/auth": "^0.0.90",
    "@convex-dev/better-auth": "^0.10.9",
    "@icons-pack/react-simple-icons": "^13.8.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@shikijs/transformers": "^3.19.0",
    "@tanstack/react-table": "^8.21.3",
    "@xenova/transformers": "^2.17.2",
    "@xyflow/react": "^12.8.6",
    "ai": "^5.0.80",
    "ai-elements": "^1.1.2",
    "better-auth": "^1.4.9",
    "chromadb": "^3.0.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.28.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.1.0",
    "glpk.js": "^4.0.2",
    "harden-react-markdown": "^1.1.5",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "javascript-lp-solver": "^0.4.24",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.6.0",
    "katex": "^0.16.25",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.546.0",
    "maath": "^0.10.8",
    "motion": "^12.23.24",
    "nanoid": "^5.1.6",
    "pdf-parse": "^2.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.6",
    "recharts": "^3.2.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.14.0",
    "streamdown": "^1.4.0",
    "stripe": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.180.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.1",
    "vercel": "^48.12.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jest": "^29.7.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.6.2",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^1.2.0"
  },
  "keywords": [
    "fitness",
    "ai",
    "personal-trainer",
    "groq",
    "react",
    "typescript"
  ],
  "author": "FitnessPlannerAI",
  "license": "MIT"
}
